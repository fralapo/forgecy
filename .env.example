# Forgecy configuration. Copy to .env and fill in. Secrets live only here (or a mounted secrets file).
# Generate secrets with: openssl rand -base64 32

# --- Instance -----------------------------------------------------------------
FORGECY_BASE_URL=http://localhost:3000
FORGECY_PORT=3000
FORGECY_DATA_DIR=./data
FORGECY_LOG_LEVEL=info
# Time zone for dates in the interface and in exports (IANA name). Docker passes it as TZ.
FORGECY_TIMEZONE=Europe/Rome
# Used only with the `https` Compose profile (Caddy).
FORGECY_HOSTNAME=forgecy.local

# --- Database and queue -------------------------------------------------------
# In Docker Compose these are set by docker-compose.yml; the values below are for `pnpm dev`.
POSTGRES_USER=forgecy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forgecy
DATABASE_URL=postgres://forgecy:change-me@localhost:5432/forgecy
REDIS_URL=redis://localhost:6379

# --- Access -------------------------------------------------------------------
# local: one machine, password login. intranet: trusted internal network, password login.
# team: adds magic link and Google sign-in for the domains below.
FORGECY_AUTH_MODE=local
BETTER_AUTH_SECRET=
FORGECY_ALLOWED_EMAIL_DOMAINS=
FORGECY_MAGIC_LINK_TTL_MINUTES=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra origins allowed to call the API (comma separated), e.g. https://forgecy.local
ALLOWED_ORIGINS=

# Key that encrypts BYOK provider keys saved from the UI (base64, 32 bytes). Keep it out of the DB backup.
FORGECY_ENCRYPTION_KEY=
# Shared secret between the export worker and the internal render route.
FORGECY_RENDER_TOKEN=

# --- Files --------------------------------------------------------------------
# local: files on disk under MEDIA_ROOT. s3: any S3-compatible store (the `s3` profile bundles SeaweedFS).
STORAGE_DRIVER=local
MEDIA_ROOT=./data/media
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=forgecy
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email (magic link) -------------------------------------------------------
# Use the agency's SMTP, otherwise any provider (e.g. Brevo). In development Mailpit listens on 1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Forgecy <forgecy@example.com>
SMTP_REPLY_TO=

# --- AI providers (all optional; costs are the provider's API prices) ---------
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
# Local models through an OpenAI-compatible endpoint (Ollama or LM Studio). Never used as a cloud fallback.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=

# --- Prospect audit -------------------------------------------------------------
# Path to Chromium for site screenshots. Without it pages are read as HTML only.
FORGECY_CHROMIUM_PATH=
# Allow auditing sites on the local network (off: typed URLs cannot reach router, NAS or Forgecy).
FORGECY_AUDIT_ALLOW_PRIVATE_HOSTS=false
