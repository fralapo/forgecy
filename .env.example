# Personal local installation. Copy to .env.local; never commit real keys.
# Exact browser origin, no trailing slash. Required for npm run start.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Browser-safe sb_publishable_... (or legacy anon JWT), never sb_secret_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
ENABLE_WEBSITE_INGEST=false
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
META_GRAPH_VERSION=v23.0
TOKEN_ENCRYPTION_KEY_BASE64=
# Server-only sb_secret_... (or legacy service_role JWT); jobs + usage ledger
# Never prefix this name with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
