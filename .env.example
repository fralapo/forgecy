# Personal local installation. Copy to .env.local; never commit real keys.
# Exact browser origin, no trailing slash. Required for npm run start.
APP_ORIGIN=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-flash-latest
OPENROUTER_SITE_URL=http://localhost:3000
ENABLE_WEBSITE_INGEST=true
GOOGLE_DRIVE_CLIENT_ID=
# Optional. Exact Tailscale account login allowed through Tailscale Serve.
FORGECY_TAILSCALE_ALLOWED_USER=
# Exact HTTPS MagicDNS hostname shown by `tailscale serve status` (without scheme or port).
FORGECY_TAILSCALE_HOST=
