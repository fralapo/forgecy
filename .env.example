# Forgecy configuration. Run `pnpm forgecy init` to create .env with generated secrets, or copy this
# file to .env and fill in the secrets. Secrets live only here (or a mounted secrets file).
# By hand: `openssl rand -hex 24` for POSTGRES_PASSWORD and BETTER_AUTH_SECRET;
# FORGECY_ENCRYPTION_KEY must decode to 32 bytes, so use `openssl rand -base64 32` (not hex).

# --- Instance -----------------------------------------------------------------
FORGECY_BASE_URL=http://localhost:3000
FORGECY_PORT=3000
FORGECY_DATA_DIR=./data
FORGECY_LOG_LEVEL=info
# Port of the worker's /health when running outside Docker (pnpm dev).
# WORKER_HEALTH_PORT=3001
# Host port that publishes the worker's /health (loopback only) for `pnpm forgecy health`.
# FORGECY_WORKER_HEALTH_PORT=3001
# `pnpm forgecy health` checks 127.0.0.1 on the published port, then on the pnpm dev one. To check another host or a proxy, set the full URLs:
# FORGECY_WEB_HEALTH_URL=https://forgecy.example.com/api/health
# FORGECY_WORKER_HEALTH_URL=http://worker.lan:3001/health
# Time zone for dates in the interface and in exports (IANA name). Docker passes it as TZ.
FORGECY_TIMEZONE=Europe/Rome
# Used only with the `https` Compose profile (Caddy).
FORGECY_HOSTNAME=forgecy.local

# --- Database and queue -------------------------------------------------------
# In Docker Compose these are set by docker-compose.yml; the values below are for `pnpm dev`.
POSTGRES_USER=forgecy
# Required for Docker Compose; `pnpm forgecy init` generates it. No spaces and none of / @ : % ? # [ ] $ ' " \ `
# (it goes into DATABASE_URL). Keep the same value in DATABASE_URL below.
# `pnpm dev` works with it blank: docker-compose.dev.yml then uses its local-only default.
POSTGRES_PASSWORD=
POSTGRES_DB=forgecy
DATABASE_URL=postgres://forgecy:forgecy@localhost:5432/forgecy
REDIS_URL=redis://localhost:6379

# --- Access -------------------------------------------------------------------
# local: one machine, password login. intranet: trusted internal network, password login.
# team: adds magic link and Google sign-in for the domains below.
FORGECY_AUTH_MODE=local
BETTER_AUTH_SECRET=
# Optional, 16+ characters. If set, the first-run /setup page asks for it before creating the first Admin.
# Strongly recommended whenever the instance is reachable from a network before you create the Admin.
FORGECY_SETUP_TOKEN=
FORGECY_ALLOWED_EMAIL_DOMAINS=
FORGECY_MAGIC_LINK_TTL_MINUTES=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra origins allowed to call the API (comma separated), e.g. https://forgecy.local
ALLOWED_ORIGINS=

# Key that encrypts BYOK provider keys saved from the UI (base64, 32 bytes). Keep it out of the DB backup.
FORGECY_ENCRYPTION_KEY=

# --- Files --------------------------------------------------------------------
# local: files on disk under MEDIA_ROOT. s3: any S3-compatible store (the `s3` profile bundles SeaweedFS).
# A relative MEDIA_ROOT is read from the repository root, so web and worker share it in `pnpm dev`.
STORAGE_DRIVER=local
MEDIA_ROOT=./data/media
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=forgecy
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email (magic link) -------------------------------------------------------
# Use the agency's SMTP, otherwise any provider (e.g. Brevo). In development Mailpit listens on 1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Forgecy <forgecy@example.com>
SMTP_REPLY_TO=

# --- AI providers (all optional; costs are the provider's API prices) ---------
# Defaults only: Admins choose services and models in Settings > AI providers.
# anthropic | openai | openrouter | deepseek | local
AI_DEFAULT_PROVIDER=openrouter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
# DeepSeek (text only, OpenAI-compatible API). AI_DEFAULT_PROVIDER=deepseek makes it the default.
DEEPSEEK_API_KEY=
# OpenRouter also generates images with OPENROUTER_API_KEY; pick any model with image output.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
# Image providers in order of preference: the first configured one is primary, the next the fallback.
IMAGE_PROVIDERS=openrouter,openai,google,higgsfield
# Subscriptions over MCP: connect them in Settings > AI providers (OAuth login, no API key;
# needs FORGECY_ENCRYPTION_KEY). Higgsfield spends your Higgsfield credits.
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_IMAGE_MODEL=
# Local models through an OpenAI-compatible endpoint (Ollama or LM Studio). Never used as a cloud fallback.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
# "Sign in with ChatGPT": lets each person connect their own ChatGPT account in
# Settings > AI providers (needs FORGECY_ENCRYPTION_KEY). OpenAI currently issues a
# client id only to approved partners (developers.openai.com/siwc/request-client-id);
# until one is set here (or from Settings > AI providers, as an Admin), that page shows
# "Awaiting OpenAI approval". Not a secret. Only for a confidential OAuth client.
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_CLIENT_SECRET=

# --- Prospect audit -------------------------------------------------------------
# Path to Chromium for site screenshots. Without it pages are read as HTML only.
FORGECY_CHROMIUM_PATH=
# Folder of template packages to import instead of ./templates.
# FORGECY_TEMPLATES_DIR=
# Allow auditing sites on the local network (off: typed URLs cannot reach router, NAS or Forgecy).
# Write exactly true or false (lowercase): any other value, such as 1, TRUE or yes, stops startup.
FORGECY_AUDIT_ALLOW_PRIVATE_HOSTS=false
