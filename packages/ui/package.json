{
  "name": "@forgecy/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/generated/tokens.css",
    "./styles.css": "./src/styles.css",
    "./tokens.json": "./tokens/forgecy.tokens.json",
    "./tokens": "./src/tokens.ts",
    "./cn": "./src/cn.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.52.0",
    "@radix-ui/react-slot": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
