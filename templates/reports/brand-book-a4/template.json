          "name": "title",
          "type": "text",
          "label": "Title",
          "maxChars": 40,
          "maxLines": 1,
          "required": true
        },
        {
          "name": "items",
          "type": "list",
          "label": "Sections",
          "maxChars": 32,
          "maxItems": 8,
          "required": true
        },
        {
          "name": "footer",
          "type": "text",
          "label": "Footer",
          "maxChars": 100,
          "maxLines": 1
        }
