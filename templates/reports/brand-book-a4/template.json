{
  "$schema": "../../template.schema.json",
  "id": "brand-book-a4",
  "name": "Brand Book · A4",
  "description": "The client's Brand Book as an A4 PDF in the client's own colors and fonts: strategy, verbal and visual identity, content and channels, do and don't, signed by the agency.",
  "version": "1.0.0",
  "kind": "report",
  "format": "report_a4",
  "width": 1240,
  "height": 1754,
  "slides": {
    "min": 3,
    "max": 40,
    "default": 16
  },
  "styles": ["styles.css"],
  "fonts": [
    {
      "family": "Space Grotesk",
      "file": "fonts/space-grotesk.woff2",
      "weight": "300 700",
      "license": "OFL-1.1"
    },
    {
      "family": "Inter",
      "file": "fonts/inter.woff2",
      "weight": "100 900",
      "license": "OFL-1.1"
    }
  ],
  "colorRoles": {
    "--fc-bg": {
      "role": "background",
      "fallback": "#FFFFFF"
    },
    "--fc-surface": {
      "role": "surface",
      "fallback": "#F3F2EE"
    },
    "--fc-text": {
      "role": "text.primary",
      "fallback": "#16161A"
    },
    "--fc-muted": {
      "role": "text.secondary",
      "fallback": "#55555F"
    },
    "--fc-accent": {
      "role": "accent",
      "fallback": "#2F55D4"
    },
    "--fc-cta-bg": {
      "role": "cta.bg",
      "fallback": "#16161A"
    },
    "--fc-cta-text": {
      "role": "cta.text",
      "fallback": "#FFFFFF"
    }
  },
  "fontRoles": {
    "--fc-font-heading": {
      "role": "heading",
      "fallback": "Space Grotesk"
    },
    "--fc-font-body": {
      "role": "body",
      "fallback": "Inter"
    }
  },
  "typeScale": [20, 24, 28, 32, 40, 56, 72, 96, 160],
  "rules": {
    "ctaOnlyLast": false,
    "logoOnCover": true,
    "pageNumbers": true,
    "maxImagesPerSlide": 0,
    "notes": "A book the client keeps: one idea per page, in the client's colors and fonts, signed by the agency on the last page."
  },
  "layouts": [
    {
      "id": "cover",
      "name": "Cover",
      "role": "cover",
      "position": "first",
      "file": "layouts/cover.html",
      "slots": [
        {
          "name": "kicker",
          "type": "text",
          "label": "Kicker",
          "maxChars": 40,
          "maxLines": 1
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "maxChars": 40,
          "maxLines": 2,
          "required": true,
          "highlight": true
        },
        {
          "name": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "maxChars": 200,
          "maxLines": 4
        },
        {
          "name": "version",
          "type": "text",
          "label": "Version",
          "maxChars": 24,
          "maxLines": 1
        },
        {
          "name": "date",
          "type": "text",
          "label": "Date",
          "maxChars": 24,
          "maxLines": 1
        },
        {
          "name": "prepared_by",
          "type": "text",
          "label": "Prepared by",
          "maxChars": 48,
          "maxLines": 2
        }
      ],
      "sample": {
        "kicker": "Brand Book",
        "title": "Rossi ==Coffee==",
        "subtitle": "Good coffee for people who work.",
        "version": "Version 3",
        "date": "October 2026",
        "prepared_by": "Example Agency"
      }
    },
    {
      "id": "contents",
