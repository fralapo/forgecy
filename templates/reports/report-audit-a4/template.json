{
  "$schema": "../../template.schema.json",
  "id": "report-audit-a4",
  "name": "Audit report · A4",
  "description": "A prospect's audit report as an A4 PDF: cover, sections, findings with evidence and recommendation, problems, next steps and method.",
  "version": "1.2.0",
  "kind": "report",
  "format": "report_a4",
  "width": 1240,
  "height": 1754,
  "slides": {
    "min": 4,
    "max": 40,
    "default": 12
  },
  "styles": ["styles.css"],
  "fonts": [
    {
      "family": "Space Grotesk",
      "file": "fonts/space-grotesk.woff2",
      "weight": "300 700",
      "license": "OFL-1.1"
    },
    {
      "family": "Inter",
      "file": "fonts/inter.woff2",
      "weight": "100 900",
      "license": "OFL-1.1"
    }
  ],
  "colorRoles": {
    "--fc-bg": {
      "role": "background",
      "fallback": "#FFFFFF"
    },
    "--fc-surface": {
      "role": "surface",
      "fallback": "#F3F2EE"
    },
    "--fc-text": {
      "role": "text.primary",
      "fallback": "#16161A"
    },
    "--fc-muted": {
      "role": "text.secondary",
      "fallback": "#55555F"
    },
    "--fc-accent": {
      "role": "accent",
      "fallback": "#2F55D4"
    },
    "--fc-cta-bg": {
      "role": "cta.bg",
      "fallback": "#16161A"
    },
    "--fc-cta-text": {
      "role": "cta.text",
      "fallback": "#FFFFFF"
    }
  },
  "fontRoles": {
    "--fc-font-heading": {
      "role": "heading",
      "fallback": "Space Grotesk"
    },
    "--fc-font-body": {
      "role": "body",
      "fallback": "Inter"
    }
  },
  "typeScale": [20, 24, 28, 32, 40, 56, 72, 96, 160],
  "rules": {
    "ctaOnlyLast": false,
    "logoOnCover": true,
    "pageNumbers": true,
    "maxImagesPerSlide": 1,
    "notes": "A report to read and print: one page per finding, each finding with its evidence and a concrete recommendation."
  },
  "layouts": [
    {
      "id": "cover",
      "name": "Cover",
      "role": "cover",
      "position": "first",
      "file": "layouts/cover.html",
      "slots": [
        {
          "name": "kicker",
          "type": "text",
          "label": "Kicker",
          "maxChars": 40,
          "maxLines": 1
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "maxChars": 80,
          "maxLines": 3,
          "required": true,
          "highlight": true
        },
        {
          "name": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "maxChars": 160,
          "maxLines": 3
        },
        {
          "name": "client",
          "type": "text",
          "label": "Client",
          "maxChars": 48,
          "maxLines": 2,
          "required": true
        },
        {
          "name": "date",
          "type": "text",
          "label": "Date",
          "maxChars": 24,
          "maxLines": 1
        },
        {
          "name": "prepared_by",
          "type": "text",
          "label": "Prepared by",
          "maxChars": 48,
          "maxLines": 2
        },
        {
          "name": "image",
          "type": "image",
          "label": "Image",
          "minWidth": 1080,
          "minHeight": 600
        }
      ],
      "sample": {
        "kicker": "Digital audit",
        "title": "Where Rossi Srl ==loses clients== online",
        "subtitle": "Website, social and search: what works, what doesn't and where to start.",
        "client": "Rossi Srl",
        "date": "October 2026",
        "prepared_by": "Example Agency",
        "image": {
          "asset": "assets/example-photo.svg",
          "alt": "Example screenshot"
        }
      }
    },
    {
      "id": "section",
      "name": "Section",
      "role": "section",
      "file": "layouts/section.html",
      "slots": [
        {
          "name": "number",
          "type": "text",
          "label": "Number",
          "maxChars": 4,
          "maxLines": 1
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "maxChars": 60,
          "maxLines": 2,
          "required": true,
          "highlight": true
        },
        {
          "name": "intro",
          "type": "text",
          "label": "Introduction",
          "maxChars": 420,
          "maxLines": 7
        },
        {
          "name": "items",
          "type": "list",
          "label": "List",
          "maxChars": 140,
          "maxItems": 6
        }
      ],
      "sample": {
        "number": "02",
        "title": "The ==website== today",
        "intro": "We analyzed the speed, structure and content of the main pages and compared them with three direct local competitors.",
        "items": [
          "Mobile load time over 6 seconds",
          "No dedicated pages for the main services",
          "Contact form at the bottom of the home page, with no call to action",
          "Product pages without prices or availability"
        ]
      }
    },
    {
      "id": "finding",
      "name": "Finding",
      "role": "finding",
      "file": "layouts/finding.html",
      "slots": [
        {
          "name": "label",
          "type": "text",
          "label": "Label",
          "maxChars": 40,
          "maxLines": 1
        },
        {
          "name": "severity",
          "type": "text",
          "label": "Priority",
          "maxChars": 24,
          "maxLines": 1
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "maxChars": 90,
          "maxLines": 3,
          "required": true,
          "highlight": true
        },
        {
          "name": "description",
          "type": "text",
          "label": "Description",
          "maxChars": 360,
          "maxLines": 5,
          "required": true
        },
        {
          "name": "evidence",
          "type": "text",
          "label": "Evidence",
          "maxChars": 260,
          "maxLines": 4,
          "required": true
        },
        {
          "name": "evidence_image",
          "type": "image",
          "label": "Evidence image",
          "minWidth": 800,
          "minHeight": 400
        },
        {
          "name": "recommendation",
          "type": "text",
          "label": "Recommendation",
          "maxChars": 280,
          "maxLines": 4,
          "required": true
        }
      ],
      "sample": {
        "label": "Finding 3 · Website",
        "severity": "High priority",
        "title": "The home page doesn't say ==what you do== in the first three seconds",
        "description": "The first screen shows a stock photo and a generic slogan. Visitors from Google have to scroll twice before they understand the company installs solar panels.",
        "evidence": "Session recordings: 58% of mobile visitors leave without scrolling past the first screen.",
        "evidence_image": {
          "asset": "assets/example-photo.svg",
          "alt": "Example screenshot"
        },
        "recommendation": "Rewrite the home page title with service and area (“Solar panels in Bergamo”), add a quote request button and social proof below it."
      }
    },
    {
      "id": "problem",
      "name": "Problem",
      "role": "problem",
      "file": "layouts/problem.html",
      "slots": [
        {
          "name": "label",
          "type": "text",
          "label": "Label",
          "maxChars": 40,
          "maxLines": 1
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "maxChars": 90,
          "maxLines": 3,
          "required": true,
          "highlight": true
        },
        {
          "name": "description",
          "type": "text",
          "label": "Description",
          "maxChars": 420,
          "maxLines": 6,
          "required": true
        },
        {
          "name": "impact",
          "type": "text",
          "label": "Impact",
          "maxChars": 200,
          "maxLines": 3
        },
        {
          "name": "causes",
          "type": "list",
          "label": "Causes",
          "maxChars": 100,
          "maxItems": 4
        }
      ],
      "sample": {
        "label": "Main problem",
        "title": "Leads come in, but ==nobody follows up==",
        "description": "Website enquiries land in a shared inbox that is read once a week. Nobody knows how many there are, who handled them or how many become clients.",
        "impact": "We estimate 15–20 enquiries a month with no reply within 48 hours.",
        "causes": [
          "No alert when an enquiry arrives",
          "Different forms sending to different addresses",
          "No log of handled enquiries"
        ]
      }
    },
    {
      "id": "next-steps",
      "name": "Next steps",
      "role": "next_steps",
      "file": "layouts/next-steps.html",
      "slots": [
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "maxChars": 60,
          "maxLines": 2,
          "required": true,
          "highlight": true
        },
        {
          "name": "intro",
          "type": "text",
          "label": "Introduction",
          "maxChars": 240,
          "maxLines": 3
        },
        {
          "name": "steps",
          "type": "list",
          "label": "Steps",
          "maxChars": 120,
          "minItems": 1,
          "maxItems": 5,
          "required": true
        },
        {
          "name": "note",
          "type": "text",
          "label": "Note",
          "maxChars": 160,
          "maxLines": 2
        }
      ],
      "sample": {
        "title": "Where to ==start==",
        "intro": "Three actions in order of impact: the first two take a month, without rebuilding the website.",
        "steps": [
          "New home page first screen with service, area and quote",
          "A single form with instant alerts and an enquiry log",
          "Dedicated pages for the three most searched local services",
          "Editorial plan of two posts a week on Instagram and LinkedIn"
        ],
        "note": "We'll go through it together in the follow-up call: bring your questions."
      }
    },
    {
      "id": "method",
      "name": "Method",
      "role": "method",
      "file": "layouts/method.html",
      "slots": [
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "maxChars": 60,
          "maxLines": 2,
          "required": true
        },
        {
          "name": "intro",
          "type": "text",
          "label": "Introduction",
          "maxChars": 280,
          "maxLines": 4
        },
        {
          "name": "items",
          "type": "list",
          "label": "Sources and tools",
          "maxChars": 90,
          "maxItems": 6
        },
        {
          "name": "note",
          "type": "text",
          "label": "Limitations",
          "maxChars": 200,
          "maxLines": 3
        }
      ],
      "sample": {
        "title": "How we worked",
        "intro": "The audit relies only on public data and on the access you gave us. Every finding states its source.",
        "items": [
          "Website: 24 pages analyzed on mobile and desktop",
          "Search: ranking for 40 local keywords",
          "Social: last 90 days of Instagram and LinkedIn",
          "Competitors: three companies chosen with you"
        ],
        "note": "Period analyzed: July–September 2026. Traffic figures are estimates where we had no access to the tools."
      }
    }
  ]
}
