{
  "name": "forgecy",
  "version": "13.0.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && tsx --test tests/unit/*.test.ts",
    "security:scan": "node scripts/secret-scan.mjs --tracked",
    "security:hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@napi-rs/keyring": "^2.1.1",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.1.2",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "^7.16.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
